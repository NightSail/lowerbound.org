doctype html
html(lang='en')
	head
		meta(charset='utf-8')
		meta(name='viewport' content='width=device-width, initial-scale=1')
		title Lower Bound
		meta(name='description' content='A professional floor that software engineers state in public and refuse to go below.')
		link(rel='canonical' href=`https://lowerbound.org/${current.number}/`)
		link(rel='stylesheet' href='/style.css')
	body
		a.skip-link(href='#content') Skip to content
		.site
			main#content
				block content
			footer.site-footer
				p I have a #[a(href='/') Lower Bound].
				p From #[a(href='//nightsail.net/') Night Sail].
